# ============================================================================
# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
APP_NAME=api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Admin console: open http://localhost:3000/admin.html (served by the API).
# file:// Origin "null" is allowed only when NODE_ENV is not production.

# Global HTTP rate limit (platform RateLimitGuard as APP_GUARD)
HTTP_RATE_LIMIT=120
HTTP_RATE_LIMIT_WINDOW_MS=60000
# SWAGGER_ENABLED=true  # also enable docs in production when needed

# ============================================================================
# ORM SELECTION
# Choose ONE provider per deployment: 'prisma' or 'typeorm'
# ============================================================================
ORM_PROVIDER=prisma

# ============================================================================
# DATABASE CONFIGURATION
# DB_PASSWORD→DATABASE_PASSWORD, DB_NAME→DATABASE_NAME). Explicit DATABASE_* wins when both set.
# Note: Default port is 5432 for PostgreSQL. Use 3306 if using MySQL.
# ============================================================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_db_password
DATABASE_NAME=app_db

# Prisma specific connection strings (Required if ORM_PROVIDER=prisma)
# DATABASE_URL = pooled runtime connection (e.g. Supabase pooler / PgBouncer)
# DIRECT_URL   = direct connection for migrations (required when using pgbouncer)
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/app_db?schema=public"
DIRECT_URL="postgresql://postgres:your_secure_db_password@localhost:5432/app_db?schema=public"

# ============================================================================
# REDIS CONFIGURATION (BullMQ Queues & Caching)
# Prefer REDIS_URL when set (Render Key Value, Redis Cloud, Upstash, etc.).
# Supports redis:// (plain) and rediss:// (TLS — required for Render *external* URL).
# When REDIS_URL is set, REDIS_HOST/PORT/PASSWORD are ignored for connection.
# ============================================================================
# Local:
# REDIS_URL=redis://:password@127.0.0.1:6379/0
#
# Render (same-region Web Service → Key Value): use the *internal* URL
# REDIS_URL=redis://red-xxxxxxxxxxxxxxxxxxxx:6379
#
# Render (local laptop / other region → Key Value): enable external access in
# the Key Value ACL, then use the *external* rediss:// URL from Connect.
# REDIS_URL=rediss://red-xxxxxxxx:PASSWORD@REGION-kv.render.com:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_USERNAME=

# ============================================================================
# AUTHENTICATION (JWT)
# Generate a strong secret: openssl rand -hex 64
# ============================================================================
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION=1d

# ============================================================================
# ENCRYPTION (AES-256-CBC)
# MUST be exactly 32 characters long for direct use, or it will be derived.
# Generate: openssl rand -hex 16
# ============================================================================
ENCRYPTION_SECRET_KEY=replace-with-exactly-32-characters

# ============================================================================
# EXTERNAL SERVICE INTEGRATIONS (Examples)
# Add one block per third-party API your service consumes. Prefix variables
# with the provider name for clarity, e.g. BILLING_API_KEY, SEARCH_API_URL.
# ============================================================================
EXTERNAL_SERVICE_API_KEY=your_external_service_api_key
EXTERNAL_SERVICE_API_SECRET=your_external_service_api_secret
EXTERNAL_SERVICE_BASE_URL=https://api.example.com
EXTERNAL_SERVICE_CALLBACK_URL=https://your-public-domain.com/webhooks/example

# ============================================================================
# NOTIFICATIONS (Email - SMTP)
# Canonical keys are SMTP_*. Aliases SENDER_MAIL / MAIL_PASSWORD / EMAIL_FROM
# are normalized onto SMTP_USER / SMTP_PASS / SMTP_FROM at startup.
# ============================================================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@yourdomain.com
# Optional ops contacts (not used by SMTP transport directly):
# ADMIN_EMAIL=
# ADMIN_PHONE=

# ============================================================================
# NOTIFICATIONS (Push)
# Live FCM (Firebase Admin) — when all three are real values, push requests
# leave the server and reach device tokens registered via POST /v1/push/tokens.
# Placeholder / example values keep the noop provider (safe local default).
# ============================================================================
PUSH_PROVIDER_PROJECT_ID=your_project_id
PUSH_PROVIDER_CLIENT_EMAIL=service-account@your_project.example.com
PUSH_PROVIDER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional HTTP fallbacks (used only when Firebase Admin creds are unset):
# FCM_HTTP_ENDPOINT=https://fcm.googleapis.com/v1/projects/<project>/messages:send
# FCM_SERVER_KEY=
# APNS_HTTP_ENDPOINT=
# APNS_TOKEN=

# ============================================================================
# STORAGE (S3-compatible object storage)
# Used for user uploads, generated documents, and other binary assets.
#
# STORAGE_ENGINE is an alias for STORAGE_PROVIDER (STORAGE_PROVIDER wins if
# both are set). Supported engines: local | s3 | r2 | minio | supabase | azure | gcs
#
# local     — filesystem storage, only needs STORAGE_LOCAL_DIRECTORY + STORAGE_SIGNING_SECRET
# s3        — AWS S3; STORAGE_ENDPOINT optional, uses AWS_REGION/AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# r2        — Cloudflare R2; STORAGE_ENDPOINT required (https://<account_id>.r2.cloudflarestorage.com)
# minio     — self-hosted S3-compatible; STORAGE_ENDPOINT optional
# supabase  — Supabase Storage S3 protocol; STORAGE_ENDPOINT required (project storage S3 endpoint)
# azure     — needs AZURE_STORAGE_CONNECTION_STRING + STORAGE_CONTAINER
# gcs       — needs STORAGE_BUCKET (uses Application Default Credentials)
# ============================================================================
STORAGE_ENGINE=s3
STORAGE_PROVIDER=s3
STORAGE_BUCKET=app-documents
STORAGE_ENDPOINT=https://your-storage-endpoint.example.com
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_SIGNING_SECRET=replace-with-a-long-random-secret
STORAGE_MAX_BYTES=10485760
STORAGE_ALLOWED_CONTENT_TYPES=image/*,application/pdf

# ============================================================================
# REALTIME COMMUNICATION PLATFORM (`src/platform/realtime`)
# Business modules inject RealtimeService only — never raw Socket.IO.
# When enabled, Socket.IO is the primary transport (polling is fallback only).
# Connect clients to namespace `/realtime` with Bearer JWT (auth.token or Authorization).
#
# REALTIME_PROVIDER: noop | nest-ws | socketio | sse | firebase | pusher | ably
# REALTIME_TRANSPORT: ws | socketio | sse | none
# REALTIME_AUTH: jwt | api-key | anonymous
# When REALTIME_ENABLED=false the platform always uses NoopRealtimeProvider.
# ============================================================================
REALTIME_ENABLED=true
REALTIME_PROVIDER=socketio
REALTIME_TRANSPORT=socketio
REALTIME_PORT=3001
REALTIME_HEARTBEAT=30000
REALTIME_AUTH=jwt
# REALTIME_JWT_SECRET=  # falls back to JWT_SECRET when unset
# REALTIME_API_KEYS=key1,key2
# REALTIME_MAX_CONNECTIONS=10000
# REALTIME_MAX_ROOMS=10000
# REALTIME_MAX_CONNECTIONS_PER_ROOM=1000
# REALTIME_PRESENCE_ENABLED=true
# REALTIME_PRESENCE_IDLE_MS=90000

# ============================================================================
# AUTH OTP (dev / local)
# ============================================================================
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=2592000
# AUTH_SESSION_ABSOLUTE_TTL_SECONDS=7776000
# AUTH_OTP_TTL_SECONDS=300
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_SENDS_PER_WINDOW=5
# AUTH_OTP_SEND_WINDOW_SECONDS=900
# AUTH_LOGIN_ATTEMPTS_PER_WINDOW=10
# AUTH_LOGIN_WINDOW_SECONDS=900
# AUTH_HUMAN_CHALLENGE_REQUIRED=false
# AUTH_EMAIL_PROVIDER=smtp
# AUTH_TOTP_ISSUER=DalaDrop
# Console-log plaintext OTP when NODE_ENV !== production, or force with:
# AUTH_OTP_CONSOLE_LOG=true
# Skip SMS/email delivery in non-production (default). Force real send with:
# AUTH_OTP_FORCE_SEND=true
# Always skip provider send (even in production — use carefully):
# AUTH_OTP_SKIP_SEND=true

# ============================================================================
# AFRICA'S TALKING (SMS)
# Prefer live AT_USERNAME when the key authorizes it; otherwise use sandbox.
# AT_SHORTCODE is account metadata only (not sent as SMS "from").
# AT_SENDER_ID is the registered alphanumeric sender / shortcode used as "from".
# ============================================================================
AT_ENVIRONMENT=sandbox
AT_USERNAME=
AT_SHORTCODE=
AT_SENDER_ID=
AT_SENDER_ID_LOCAL=sandbox
AT_API_KEY=
AT_BASE_URL=https://api.sandbox.africastalking.com
AUTH_SMS_PROVIDER=africastalking
# Fallback generic HTTP SMS (when AT_* unset):
# SMS_PROVIDER_URL=
# SMS_PROVIDER_TOKEN=
AUTH_OTP_CONSOLE_LOG=
AUTH_OTP_FORCE_SEND=

# ============================================================================
# AUTH PASSWORD POLICY
# ============================================================================
# AUTH_PASSWORD_MIN_LENGTH=8
# AUTH_PASSWORD_REQUIRE_UPPERCASE=true
# AUTH_PASSWORD_REQUIRE_LOWERCASE=true
# AUTH_PASSWORD_REQUIRE_NUMBER=true
# AUTH_PASSWORD_REQUIRE_SYMBOL=true
# AUTH_PASSWORD_BCRYPT_ROUNDS=12

# ============================================================================
# OBSERVABILITY
# ============================================================================
LOG_LEVEL=debug
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5044
METRICS_TOKEN=your_secure_metrics_scrape_token
SENTRY_DSN=

# ============================================================================
# OBSERVABILITY PLATFORM (enterprise)
# Master switch + per-feature switches. When OBSERVABILITY_ENABLED=false, or
# a feature-specific *_ENABLED flag is false, ObservabilityModule.forRoot()
# always falls back to a safe noop/in-memory implementation for that feature
# — the app keeps booting even with nothing configured.
#
# OBSERVABILITY_TRACER:         noop | memory | otel
# OBSERVABILITY_LOGGER:         json | pino | winston
# OBSERVABILITY_METRICS:        memory | prometheus | otel
# OBSERVABILITY_ERROR_REPORTER: memory | sentry | bugsnag | noop
# ============================================================================
OBSERVABILITY_ENABLED=true
TRACING_ENABLED=true
METRICS_ENABLED=true
LOGGING_ENABLED=true
ERROR_REPORTING_ENABLED=true
PROFILING_ENABLED=true
OBSERVABILITY_TRACER=memory
OBSERVABILITY_LOGGER=json
OBSERVABILITY_METRICS=memory
OBSERVABILITY_ERROR_REPORTER=memory

# ============================================================================
# OPENTELEMETRY
# All @opentelemetry/* packages are optional runtime drivers (see
# src/platform/observability/providers/opentelemetry). Set OTEL_ENABLED=true
# and OBSERVABILITY_TRACER=otel (and/or OBSERVABILITY_METRICS=otel) after
# installing @opentelemetry/api and the exporter package you need.
#
# OTEL_EXPORTER: otlp | jaeger | zipkin | tempo | prometheus | console | noop
# ============================================================================
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=daladrop-api
OTEL_SERVICE_VERSION=1.0.0
AUTO_INSTRUMENTATION=false

# ============================================================================
# PAYMENTS
# Architecture: PaymentMethod (rail, e.g. MOBILE_MONEY) → PaymentProvider
# (gateway code, e.g. MPESA_DARAJA | KOPOKOPO | MANUAL) → Provider API SDK.
#
# M-Pesa is the payment rail / method. Daraja is Safaricom's API gateway.
# Canonical env prefix for the Safaricom adapter is DARAJA_*.
# Legacy MPESA_* names are accepted as aliases (mapped at startup).
#
# Official Daraja STK (M-Pesa Express) credentials (developer.safaricom.co.ke):
#   Consumer Key, Consumer Secret, Business Short Code, Passkey, CallBackURL
# Official STK callbacks do NOT include an app callback token or HMAC signature.
# DARAJA_CALLBACK_TOKEN / DARAJA_CALLBACK_SIGNING_SECRET are optional *app*
# protections (e.g. edge injects x-callback-token) — not Daraja API fields.
# ============================================================================
PAYMENTS_HTTP_TIMEOUT_MS=10000
# ORDERS_STK_ON_PLACE=true

DARAJA_ENABLED=false
# Sandbox: https://sandbox.safaricom.co.ke  |  Production: https://api.safaricom.co.ke
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORT_CODE=
DARAJA_PASSKEY=
# TransactionType: CustomerPayBillOnline | CustomerBuyGoodsOnline
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Must be publicly reachable HTTPS in production (Daraja CallBackURL)
DARAJA_CALLBACK_URL=https://your-public-domain.com/v1/payment-providers/MPESA_DARAJA/callback
# Optional app-layer only (NOT an official Daraja field):
DARAJA_CALLBACK_TOKEN=
DARAJA_CALLBACK_SIGNING_SECRET=
# Reversal / B2C-style initiator credentials (required only when reversing):
DARAJA_INITIATOR_NAME=
DARAJA_SECURITY_CREDENTIAL=
DARAJA_REVERSAL_RESULT_URL=
DARAJA_REVERSAL_TIMEOUT_URL=

# Legacy aliases (optional — prefer DARAJA_* above):
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
MPESA_RESULT_URL=
# C2B confirmation URL — not used by STK adapter today
MPESA_CONFIRMATION_URL=

# Mail aliases (optional — prefer SMTP_*):
SENDER_MAIL=
MAIL_PASSWORD=
ADMIN_EMAIL=
ADMIN_PHONE=

KOPOKOPO_ENABLED=false
KOPOKOPO_BASE_URL=https://sandbox.kopokopo.com
KOPOKOPO_CLIENT_ID=
KOPOKOPO_CLIENT_SECRET=
KOPOKOPO_TILL_NUMBER=
KOPOKOPO_CALLBACK_URL=https://your-public-domain.com/v1/payment-providers/KOPOKOPO/webhook
KOPOKOPO_WEBHOOK_SECRET=

# ============================================================================
# STORAGE extras (local engine / public media)
# ============================================================================
STORAGE_LOCAL_DIRECTORY=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/v1/media
