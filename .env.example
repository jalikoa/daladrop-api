# ============================================================================
# APP CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
APP_NAME=HMS API
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# ============================================================================
# ORM SELECTION
# Choose ONE: 'prisma' or 'typeorm'
# ============================================================================
ORM_TYPE=prisma

# ============================================================================
# DATABASE CONFIGURATION
# Note: Default port is 5432 for PostgreSQL. Use 3306 if DB_TYPE=mysql.
# ============================================================================
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=hms_db
DB_SYNC=false

# Prisma specific connection string (Required if ORM_TYPE=prisma)
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/hms_db?schema=public"

# ============================================================================
# REDIS CONFIGURATION (BullMQ Queues & Caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================================
# AUTHENTICATION (JWT)
# ============================================================================
JWT_SECRET=23de663aa9b80d362f7bf7cd6daf309809906774a39271ff887a1b41b66562458fdce015c142a56aef7d427a34e6ac5d1cbe6aec545e220c6721ebe4d3b11bd34bfe26b0c18cb872
JWT_EXPIRATION=1d

# ============================================================================
# ENCRYPTION (AES-256-CBC)
# MUST be exactly 32 characters long for direct use, or it will be derived.
# ============================================================================
ENCRYPTION_SECRET_KEY=abcdefghijklmnopqrstuvwxyz123456

# ============================================================================
# PAYMENTS (Safaricom Daraja / M-Pesa)
# ============================================================================
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_PAYBILL=174379
DARAJA_PASSKEY=your_daraja_sandbox_passkey
DARAJA_CALLBACK_URL=https://your-public-domain.com/webhooks/daraja/stk

# ============================================================================
# NOTIFICATIONS (Africa's Talking - SMS)
# ============================================================================
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your_africastalking_api_key

# ============================================================================
# NOTIFICATIONS (Firebase - Push)
# ============================================================================
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# NOTIFICATIONS (Email - SMTP)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
SMTP_FROM=noreply@yourdomain.com

# ============================================================================
# STORAGE (Supabase Storage / AWS S3)
# Used for patient documents, radiology images, and profile pictures.
# ============================================================================
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=hms-documents
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1
STORAGE_ACCESS_KEY=your_supabase_anon_or_service_role_key
STORAGE_SECRET_KEY=your_supabase_service_role_key

# ============================================================================
# OBSERVABILITY
# ============================================================================
LOG_LEVEL=debug
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=your_elastic_password
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000
METRICS_TOKEN=your_secure_metrics_scrape_token
SENTRY_DSN=