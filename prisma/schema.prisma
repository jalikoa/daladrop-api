  basePriceAmount          BigInt    @default(0) @map("base_price_amount")
  distanceFeeAmount        BigInt    @default(0) @map("distance_fee_amount")
  durationFeeAmount        BigInt    @default(0) @map("duration_fee_amount")
  surgeAmount              BigInt    @default(0) @map("surge_amount")
  peakAmount               BigInt    @default(0) @map("peak_amount")
  platformFeeAmount        BigInt    @default(0) @map("platform_fee_amount")
  serviceFeeAmount         BigInt    @default(0) @map("service_fee_amount")
  taxAmount                BigInt    @default(0) @map("tax_amount")
  discountAmount           BigInt    @default(0) @map("discount_amount")
  couponAmount             BigInt    @default(0) @map("coupon_amount")
  walletCreditAmount       BigInt    @default(0) @map("wallet_credit_amount")
  promotionAmount          BigInt    @default(0) @map("promotion_amount")
  deliveryFeeAmount        BigInt    @default(0) @map("delivery_fee_amount")
  totalAmount              BigInt    @map("total_amount")
  merchantEarningsAmount   BigInt    @default(0) @map("merchant_earnings_amount")
  riderEarningsAmount      BigInt    @default(0) @map("rider_earnings_amount")
  platformRevenueAmount    BigInt    @default(0) @map("platform_revenue_amount")
  distanceKm               Decimal?  @map("distance_km") @db.Decimal(8, 3)
  durationMinutes          Int?      @map("duration_minutes")
  etaMinutes               Int?      @map("eta_minutes")
  estimatedCompletionAt    DateTime? @map("estimated_completion_at") @db.Timestamptz(6)
  surgeMultiplier          Decimal?  @map("surge_multiplier") @db.Decimal(6, 3)
  deliveryPricingRuleId    String?   @map("delivery_pricing_rule_id") @db.Uuid
  breakdown                Json?
  requestSnapshot          Json?     @map("request_snapshot")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt               DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]
  rides  Ride[]

  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@index([quoteType, createdAt])
  @@map("pricing_quotes")
}

/// Unified proof of delivery for orders and rides.
model ProofOfDelivery {
  id              String    @id @default(uuid()) @db.Uuid
  orderId         String?   @unique @map("order_id") @db.Uuid
  rideId          String?   @unique @map("ride_id") @db.Uuid
  photoUrl        String?   @map("photo_url") @db.Text
  signatureUrl    String?   @map("signature_url") @db.Text
  recipientName   String?   @map("recipient_name") @db.VarChar(200)
  notes           String?   @db.VarChar(500)
  otpCodeHash     String?   @map("otp_code_hash") @db.VarChar(128)
  otpVerifiedAt   DateTime? @map("otp_verified_at") @db.Timestamptz(6)
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  confirmedAt     DateTime  @default(now()) @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy     String?   @map("confirmed_by") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "proof_of_delivery_order_fkey")
  ride  Ride?  @relation(fields: [rideId], references: [id], onDelete: Cascade, map: "proof_of_delivery_ride_fkey")

  @@index([confirmedAt])
  @@map("proof_of_delivery")
}

/// Immutable entity audit trail (not HTTP access logs).
model AuditRecord {
  id            String      @id @default(uuid()) @db.Uuid
  tableName     String      @map("table_name") @db.VarChar(64)
  recordId      String      @map("record_id") @db.Uuid
  action        AuditAction
  actorId       String?     @map("actor_id") @db.Uuid
  actorType     ActorType   @default(SYSTEM) @map("actor_type")
  beforeData    Json?       @map("before_data")
  afterData     Json?       @map("after_data")
  changedFields String[]    @default([]) @map("changed_fields")
  reason        String?     @db.VarChar(500)
  traceId       String?     @map("trace_id") @db.VarChar(64)
  correlationId String?     @map("correlation_id") @db.VarChar(64)
  ipAddress     String?     @map("ip_address") @db.VarChar(64)
  device        String?     @db.VarChar(128)
  userAgent     String?     @map("user_agent") @db.Text
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tableName, recordId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId])
  @@map("audit_records")
}

model OutboxEvent {
  id           String       @id @default(uuid()) @db.Uuid
  eventId      String       @unique @map("event_id") @db.VarChar(80)
  aggregateId  String       @map("aggregate_id") @db.VarChar(80)
  eventName    String       @map("event_name") @db.VarChar(128)
  eventVersion Int          @default(1) @map("event_version")
  payload      Json
  metadata     Json?
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  availableAt  DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt  DateTime?    @map("published_at") @db.Timestamptz(6)
  lastError    String?      @map("last_error") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@index([aggregateId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  id           String           @id @default(uuid()) @db.Uuid
  key          String           @db.VarChar(512)
  tenantId     String?          @map("tenant_id") @db.VarChar(64)
  principalId  String?          @map("principal_id") @db.Uuid
  method       String           @default("*") @db.VarChar(16)
  path         String           @default("*") @db.VarChar(255)
  requestHash  String           @map("request_hash") @db.Char(64)
  ownerToken   String?          @map("owner_token") @db.VarChar(64)
  state        IdempotencyState @default(IN_PROGRESS)
  responseCode Int?             @map("response_code")
  responseBody Json?            @map("response_body")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)

  @@unique([key, tenantId, principalId])
  @@index([expiresAt])
  @@index([ownerToken])
  @@map("idempotency_records")
}

model WebhookDeliveryLog {
  id          String   @id @default(uuid()) @db.Uuid
  destination String   @db.VarChar(255)
  eventName   String   @map("event_name") @db.VarChar(128)
  payload     Json
  statusCode  Int?     @map("status_code")
  success     Boolean  @default(false)
  attempts    Int      @default(1)
  lastError   String?  @map("last_error") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([destination, createdAt])
  @@index([eventName, createdAt])
  @@map("webhook_delivery_logs")
}

model ApiClient {
  id               String    @id @default(uuid()) @db.Uuid
  name             String    @db.VarChar(120)
  clientId         String    @unique @map("client_id") @db.VarChar(64)
  clientSecretHash String    @map("client_secret_hash") @db.Char(64)
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  apiKeys ApiKey[]

  @@map("api_clients")
}

model ApiKey {
  id        String    @id @default(uuid()) @db.Uuid
  clientId  String    @map("client_id") @db.Uuid
  name      String    @db.VarChar(120)
  keyPrefix String    @map("key_prefix") @db.VarChar(16)
  keyHash   String    @map("key_hash") @db.Char(64)
  scopes    String[]  @default([])
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "api_keys_client_fkey")

  @@index([keyPrefix])
  @@index([clientId])
  @@map("api_keys")
}
