// ============================================================================
// DalaDrop — Production PostgreSQL schema (Prisma 5.22)
// ============================================================================
// Conventions:
//   • UUID v4 PKs (@db.Uuid)
//   • camelCase fields → snake_case columns via @map
//   • Plural snake_case tables via @@map
//   • Money: BigInt minor units + Char(3) currency (see Money VO)
//   • Soft delete: deletedAt (+ deletedBy / deleteReason) on mutable entities
//   • NEVER soft-delete journals, journal lines, audit logs, or posted payments
//   • version Int for optimistic locking on aggregates
//   • Timestamptz(6) for all timestamps
//
// Safety: generate migrations only; do NOT run migrate/deploy against live DB
// from automated agents. Operators apply after review.
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgcrypto, postgis]
}

