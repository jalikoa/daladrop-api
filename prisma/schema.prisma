model CourierPartner {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(200)
  brandUrl  String?   @map("brand_url") @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rides Ride[]

  @@map("courier_partners")
}

model InterCountyRoute {
  id               String    @id @default(uuid()) @db.Uuid
  label            String    @db.VarChar(200)
  quotedFareAmount BigInt    @map("quoted_fare_amount")
  currency         String    @default("KES") @db.Char(3)
  defaultPickup    String?   @map("default_pickup") @db.Text
  defaultDropoff   String?   @map("default_dropoff") @db.Text
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  rides Ride[]

  @@map("inter_county_routes")
}

model Ride {
  id                       String                                @id @default(uuid()) @db.Uuid
  customerId               String                                @map("customer_id") @db.Uuid
  riderId                  String?                               @map("rider_id") @db.Uuid
  serviceType              RideServiceType                       @map("service_type")
  status                   RideStatus                            @default(PENDING_PAYMENT)
  vehicleType              String?                               @map("vehicle_type") @db.VarChar(64)
  pickupAddress            String?                               @map("pickup_address") @db.Text
  pickupLatitude           Decimal                               @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude          Decimal                               @map("pickup_longitude") @db.Decimal(10, 7)
  dropoffAddress           String?                               @map("dropoff_address") @db.Text
  dropoffLatitude          Decimal                               @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude         Decimal                               @map("dropoff_longitude") @db.Decimal(10, 7)
  pickupLocation           Unsupported("geography(Point,4326)")? @map("pickup_location")
  dropoffLocation          Unsupported("geography(Point,4326)")? @map("dropoff_location")
  fareAmount               BigInt                                @map("fare_amount")
  currency                 String                                @default("KES") @db.Char(3)
  baseCurrency             String                                @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate             Decimal                               @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  distanceKm               Decimal?                              @map("distance_km") @db.Decimal(8, 3)
  polyline                 String?                               @db.Text
  deliveryPricingRuleId    String?                               @map("delivery_pricing_rule_id") @db.Uuid
  riderPayAmount           BigInt                                @default(0) @map("rider_pay_amount")
  platformCommissionAmount BigInt                                @default(0) @map("platform_commission_amount")
  paymentStatus            PaymentStatus                         @default(PENDING) @map("payment_status")
  itemDescription          String?                               @map("item_description") @db.Text
  receiverPhone            String?                               @map("receiver_phone") @db.VarChar(32)
  weightCategory           ParcelWeightCategory?                 @map("weight_category")
  parcelSize               String?                               @map("parcel_size") @db.VarChar(64)
  packageWeightKg          Decimal?                              @map("package_weight_kg") @db.Decimal(8, 3)
  packageLengthCm          Decimal?                              @map("package_length_cm") @db.Decimal(8, 2)
  packageWidthCm           Decimal?                              @map("package_width_cm") @db.Decimal(8, 2)
  packageHeightCm          Decimal?                              @map("package_height_cm") @db.Decimal(8, 2)
  parcelPricingProfileId   String?                               @map("parcel_pricing_profile_id") @db.Uuid
  courierPartnerId         String?                               @map("courier_partner_id") @db.Uuid
  interCountyRouteId       String?                               @map("inter_county_route_id") @db.Uuid
  shareToken               String?                               @unique @map("share_token") @db.VarChar(64)
  customerHiddenAt         DateTime?                             @map("customer_hidden_at") @db.Timestamptz(6)
  assignedAt               DateTime?                             @map("assigned_at") @db.Timestamptz(6)
  startedAt                DateTime?                             @map("started_at") @db.Timestamptz(6)
  completedAt              DateTime?                             @map("completed_at") @db.Timestamptz(6)
  cancelledAt              DateTime?                             @map("cancelled_at") @db.Timestamptz(6)
  cancelReason             String?                               @map("cancel_reason") @db.VarChar(500)
  etaMinutes               Int?                                  @map("eta_minutes") @db.SmallInt
  surgeMultiplier          Decimal?                              @map("surge_multiplier") @db.Decimal(6, 3)
  podPhotoUrl              String?                               @map("pod_photo_url") @db.Text
  podSignatureUrl          String?                               @map("pod_signature_url") @db.Text
  podNotes                 String?                               @map("pod_notes") @db.VarChar(500)
  /// Persisted transport quote that priced this ride.
  pricingQuoteId           String?                               @map("pricing_quote_id") @db.Uuid
  version                  Int                                   @default(0)
  createdAt                DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  deletedBy                String?                               @map("deleted_by") @db.Uuid
  deleteReason             String?                               @map("delete_reason") @db.VarChar(500)

  customer             User                  @relation("CustomerRides", fields: [customerId], references: [id], onDelete: Restrict, map: "rides_customer_fkey")
  rider                Rider?                @relation(fields: [riderId], references: [id], onDelete: SetNull, map: "rides_rider_fkey")
  courierPartner       CourierPartner?       @relation(fields: [courierPartnerId], references: [id], onDelete: SetNull, map: "rides_courier_fkey")
  interCountyRoute     InterCountyRoute?     @relation(fields: [interCountyRouteId], references: [id], onDelete: SetNull, map: "rides_route_fkey")
  deliveryPricingRule  DeliveryPricingRule?  @relation(fields: [deliveryPricingRuleId], references: [id], onDelete: SetNull, map: "rides_pricing_rule_fkey")
  parcelPricingProfile ParcelPricingProfile? @relation(fields: [parcelPricingProfileId], references: [id], onDelete: SetNull, map: "rides_parcel_profile_fkey")
  pricingQuote         PricingQuote?         @relation(fields: [pricingQuoteId], references: [id], onDelete: SetNull, map: "rides_pricing_quote_fkey")
  statusHistory        RideStatusHistory[]
  payments             Payment[]
  escrowHolds          EscrowHold[]
  reviews              Review[]
  proofOfDelivery      ProofOfDelivery?

  @@index([customerId, createdAt])
  @@index([riderId, status])
  @@index([status, paymentStatus, createdAt])
  @@index([serviceType, status])
  @@index([customerHiddenAt])
  @@map("rides")
}

model RideStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  rideId     String      @map("ride_id") @db.Uuid
  fromStatus RideStatus? @map("from_status")
  toStatus   RideStatus  @map("to_status")
  actorType  ActorType   @default(SYSTEM) @map("actor_type")
  actorId    String?     @map("actor_id") @db.Uuid
  reason     String?     @db.VarChar(500)
  latitude   Decimal?    @db.Decimal(10, 7)
  longitude  Decimal?    @db.Decimal(10, 7)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  ride Ride @relation(fields: [rideId], references: [id], onDelete: Cascade, map: "ride_status_history_ride_fkey")

  @@index([rideId, createdAt])
  @@map("ride_status_history")
}

