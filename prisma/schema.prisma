// ============================================================================
// IDENTITY & ACCESS
// ============================================================================

/// End-user account (customer, rider, seller, organizer, admin).
model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @db.VarChar(255)
  phone           String?    @db.VarChar(32)
  phoneE164       String?    @map("phone_e164") @db.VarChar(20)
  firstName       String?    @map("first_name") @db.VarChar(100)
  lastName        String?    @map("last_name") @db.VarChar(100)
  displayName     String?    @map("display_name") @db.VarChar(200)
  photoUrl        String?    @map("photo_url") @db.Text
  status          UserStatus @default(PENDING_VERIFICATION)
  statusReason    String?    @map("status_reason") @db.VarChar(500)
  statusChangedAt DateTime?  @map("status_changed_at") @db.Timestamptz(6)
  statusChangedBy String?    @map("status_changed_by") @db.Uuid
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  version         Int        @default(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?    @map("deleted_by") @db.Uuid
  deleteReason    String?    @map("delete_reason") @db.VarChar(500)
  createdBy       String?    @map("created_by") @db.Uuid
  updatedBy       String?    @map("updated_by") @db.Uuid

  credential         UserCredential?
  securitySettings   UserSecuritySettings?
  mfaFactors         MfaFactor[]
  mfaChallenges      MfaLoginChallenge[]
  passwordHistory    PasswordHistory[]
  socialIdentities   SocialIdentity[]
  roles              UserRole[]
  sessions           Session[]
  devices            Device[]
  loginAttempts      LoginAttempt[]
  legalAcceptances   LegalAcceptance[]
  ageVerifications   AgeVerification[]
  savedPlaces        SavedPlace[]
  pushTokens               PushToken[]
  notifications            Notification[]
  notificationPreference   NotificationPreference?
  menuFavourites           MenuFavourite[]
  savedItems               SavedItem[]
  carts              Cart[]
  orders             Order[]               @relation("CustomerOrders")
  rides              Ride[]                @relation("CustomerRides")
  riderProfile       Rider?
  ownedMerchants     Merchant[]            @relation("MerchantOwner")
  organizedEvents    EventOrganizer?
  eventBookings      EventBooking[]
  reviewsAuthored    Review[]              @relation("ReviewAuthor")
  wallets            Wallet[]
  otpChallenges      OtpChallenge[]
  adminNotesAuthored AdminNote[]           @relation("AdminNoteAuthor")
  supportTickets     SupportTicket[]       @relation("SupportTicketRequester")

  @@unique([email])
  @@unique([phoneE164])
  @@index([status, createdAt])
  @@index([deletedAt])
  @@index([phone])
  @@map("users")
}

model UserCredential {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  algorithm     String   @default("bcrypt") @db.VarChar(32)
  passwordSetAt DateTime @default(now()) @map("password_set_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_credentials_user_fkey")

  @@map("user_credentials")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "password_history_user_fkey")

  @@index([userId, createdAt])
  @@map("password_history")
}

model SocialIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(32)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  email          String?  @db.VarChar(255)
  rawProfile     Json?    @map("raw_profile")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "social_identities_user_fkey")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_identities")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        RoleCode @unique
  name        String   @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(128)
  resource    String   @db.VarChar(64)
  action      String   @db.VarChar(64)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  roles RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, map: "role_permissions_role_fkey")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, map: "role_permissions_permission_fkey")

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  assignedBy String?   @map("assigned_by") @db.Uuid
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_roles_user_fkey")
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, map: "user_roles_role_fkey")

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// Persistent session matching platform SessionRecord (refresh token hashed).
model Session {
  id                        String    @id @default(uuid()) @db.Uuid
  userId                    String    @map("user_id") @db.Uuid
  deviceId                  String?   @map("device_id") @db.Uuid
  refreshTokenHash          String    @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash  String?   @map("previous_refresh_token_hash") @db.Char(64)
  rolesSnapshot             String[]  @map("roles_snapshot")
  ip                        String?   @db.VarChar(64)
  userAgent                 String?   @map("user_agent") @db.Text
  expiresAt                 DateTime  @map("expires_at") @db.Timestamptz(6)
  absoluteExpiresAt         DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  revokedAt                 DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, map: "sessions_user_fkey")
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull, map: "sessions_device_fkey")

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([refreshTokenHash])
  @@index([previousRefreshTokenHash])
  @@map("sessions")
}

model Device {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  fingerprint String    @db.VarChar(128)
  platform    String?   @db.VarChar(32)
  model       String?   @db.VarChar(100)
  osVersion   String?   @map("os_version") @db.VarChar(64)
  appVersion  String?   @map("app_version") @db.VarChar(64)
  pushEnabled Boolean   @default(true) @map("push_enabled")
  trustedAt   DateTime? @map("trusted_at") @db.Timestamptz(6)
  lastSeenAt  DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "devices_user_fkey")
  sessions Session[]

  @@unique([userId, fingerprint])
  @@index([userId, deletedAt])
  @@map("devices")
}

model LoginAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  identifier    String   @db.VarChar(255)
  success       Boolean
  failureReason String?  @map("failure_reason") @db.VarChar(128)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text
  deviceId      String?  @map("device_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "login_attempts_user_fkey")

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model OtpChallenge {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String?    @map("user_id") @db.Uuid
  identifier      String     @db.VarChar(255)
  channel         OtpChannel
  purpose         OtpPurpose
  codeHash        String     @map("code_hash") @db.Char(64)
  attempts        Int        @default(0)
  maxAttempts     Int        @default(5) @map("max_attempts")
  /// SHA-256 digest of the one-time signup token; never stores the raw token.
  signupTokenHash String?    @map("signup_token") @db.VarChar(128)
  expiresAt       DateTime   @map("expires_at") @db.Timestamptz(6)
  verifiedAt      DateTime?  @map("verified_at") @db.Timestamptz(6)
  consumedAt      DateTime?  @map("consumed_at") @db.Timestamptz(6)
  sentAt          DateTime?  @map("sent_at") @db.Timestamptz(6)
  resendCount     Int        @default(0) @map("resend_count")
  deliveryJobId   String?    @map("delivery_job_id") @db.VarChar(128)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "otp_challenges_user_fkey")

  @@index([identifier, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

/// Per-user security policy. MFA is opt-in unless an authorization policy
/// requires it for a privileged role or sensitive operation.
model UserSecuritySettings {
  userId                        String     @id @map("user_id") @db.Uuid
  mfaEnabled                    Boolean    @default(false) @map("mfa_enabled")
  preferredMfaMethod            MfaMethod? @map("preferred_mfa_method")
  requireMfaForSensitiveActions Boolean    @default(false) @map("require_mfa_for_sensitive_actions")
  version                       Int        @default(0)
  createdAt                     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "user_security_settings_user_fkey")

  @@map("user_security_settings")
}

/// MFA enrollment. TOTP secrets are encrypted by the application before
/// persistence. EMAIL/SMS factors store only their normalized destination.
model MfaFactor {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  method             MfaMethod
  status             MfaFactorStatus @default(PENDING)
  label              String?         @db.VarChar(100)
  secretEncrypted    String?         @map("secret_encrypted") @db.Text
  deliveryIdentifier String?         @map("delivery_identifier") @db.VarChar(255)
  verifiedAt         DateTime?       @map("verified_at") @db.Timestamptz(6)
  lastUsedAt         DateTime?       @map("last_used_at") @db.Timestamptz(6)
  disabledAt         DateTime?       @map("disabled_at") @db.Timestamptz(6)
  version            Int             @default(0)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade, map: "mfa_factors_user_fkey")
  recoveryCodes   MfaRecoveryCode[]
  loginChallenges MfaLoginChallenge[]

  @@index([userId, status])
  @@index([userId, method])
  @@map("mfa_factors")
}

/// Single-use recovery codes. Only SHA-256 digests are persisted.
model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  factorId  String    @map("factor_id") @db.Uuid
  codeHash  String    @unique @map("code_hash") @db.Char(64)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  factor MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade, map: "mfa_recovery_codes_factor_fkey")

  @@index([factorId, usedAt])
  @@map("mfa_recovery_codes")
}

/// Short-lived, single-use TOTP login challenge. Keeping this server-side
/// prevents replay of a signed challenge token within its validity window.
model MfaLoginChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  factorId    String    @map("factor_id") @db.Uuid
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade, map: "mfa_login_challenges_user_fkey")
  factor MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade, map: "mfa_login_challenges_factor_fkey")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("mfa_login_challenges")
}

/// Immutable legal acceptance records.
model LegalAcceptance {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  documentType  String   @map("document_type") @db.VarChar(64)
  version       String   @db.VarChar(32)
  fullName      String?  @map("full_name") @db.VarChar(200)
  signatureName String?  @map("signature_name") @db.VarChar(200)
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  ip            String?  @db.VarChar(64)
  userAgent     String?  @map("user_agent") @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, map: "legal_acceptances_user_fkey")

  @@index([userId, documentType])
  @@map("legal_acceptances")
}

model AgeVerification {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @map("user_id") @db.Uuid
  status           AgeVerificationStatus  @default(UNVERIFIED)
  method           AgeVerificationMethod?
  documentType     String?                @map("document_type") @db.VarChar(64)
  documentImageUrl String?                @map("document_image_url") @db.Text
  dateOfBirth      DateTime?              @map("date_of_birth") @db.Date
  verifiedAt       DateTime?              @map("verified_at") @db.Timestamptz(6)
  reviewedBy       String?                @map("reviewed_by") @db.Uuid
  reviewNotes      String?                @map("review_notes") @db.Text
  version          Int                    @default(0)
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "age_verifications_user_fkey")

  @@index([userId, status])
  @@map("age_verifications")
}

model SavedPlace {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  label     String    @db.VarChar(100)
  icon      String?   @db.VarChar(64)
  address   String    @db.Text
  placeId   String?   @map("place_id") @db.VarChar(255)
  latitude  Decimal?  @db.Decimal(10, 7)
  longitude Decimal?  @db.Decimal(10, 7)
  pinned    Boolean   @default(false)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "saved_places_user_fkey")

  @@index([userId, deletedAt])
  @@map("saved_places")
}

// ============================================================================
// MERCHANTS & STORES
// ============================================================================

model Merchant {
  id           String         @id @default(uuid()) @db.Uuid
  ownerUserId  String         @map("owner_user_id") @db.Uuid
  name         String         @db.VarChar(200)
  legalName    String?        @map("legal_name") @db.VarChar(255)
  status       MerchantStatus @default(DRAFT)
  taxId        String?        @map("tax_id") @db.VarChar(64)
  featured     Boolean        @default(false)
  /// When true, merchant may host events / sell tickets as products.
  isOrganizer  Boolean        @default(false) @map("is_organizer")
  version      Int            @default(0)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt    DateTime?      @map("deleted_at") @db.Timestamptz(6)
  deletedBy    String?        @map("deleted_by") @db.Uuid
  deleteReason String?        @map("delete_reason") @db.VarChar(500)
  createdBy    String?        @map("created_by") @db.Uuid
  updatedBy    String?        @map("updated_by") @db.Uuid

  owner     User               @relation("MerchantOwner", fields: [ownerUserId], references: [id], onDelete: Restrict, map: "merchants_owner_fkey")
  stores    Store[]
  contracts MerchantContract[]
  events    Event[]
  wallet    Wallet?            @relation("MerchantWallet")
  kyc       MerchantKyc?

  @@index([ownerUserId, status])
  @@index([status, featured])
  @@index([deletedAt])
  @@map("merchants")
}

model MerchantKyc {
  id                         String            @id @default(uuid()) @db.Uuid
  merchantId                 String            @unique @map("merchant_id") @db.Uuid
  status                     MerchantKycStatus @default(NOT_STARTED)
  businessRegistrationNumber String?           @map("business_registration_number") @db.VarChar(128)
  taxPin                     String?           @map("tax_pin") @db.VarChar(64)
  directorIdNumber           String?           @map("director_id_number") @db.VarChar(64)
  businessAddress            String?           @map("business_address") @db.Text
  documentUrls               Json              @default("[]") @map("document_urls")
  submittedAt                DateTime?         @map("submitted_at") @db.Timestamptz(6)
  reviewedAt                 DateTime?         @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy                 String?           @map("reviewed_by") @db.Uuid
  reviewNotes                String?           @map("review_notes") @db.VarChar(1000)
  rejectionReason            String?           @map("rejection_reason") @db.VarChar(500)
  version                    Int               @default(0)
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade, map: "merchant_kyc_merchant_fkey")

  @@index([status, submittedAt])
  @@map("merchant_kyc")
}

/// Selling location. Food uses menu_* ; other verticals use products.
model Store {
  id                 String                                @id @default(uuid()) @db.Uuid
  merchantId         String                                @map("merchant_id") @db.Uuid
  storeType          StoreType                             @map("store_type")
  name               String                                @db.VarChar(200)
  slug               String?                               @db.VarChar(200)
  description        String?                               @db.Text
  city               String?                               @db.VarChar(100)
  address            String?                               @db.Text
  phone              String?                               @db.VarChar(32)
  whatsapp           String?                               @db.VarChar(32)
  email              String?                               @db.VarChar(255)
  website            String?                               @db.Text
  imageUrl           String?                               @map("image_url") @db.Text
  coverImageUrl      String?                               @map("cover_image_url") @db.Text
  latitude           Decimal?                              @db.Decimal(10, 7)
  longitude          Decimal?                              @db.Decimal(10, 7)
  /// PostGIS geography(Point,4326) — managed in SQL migration; excluded from client.
  location           Unsupported("geography(Point,4326)")?
  deliveryFeeHint    BigInt?                               @map("delivery_fee_hint")
  currency           String                                @default("KES") @db.Char(3)
  minimumOrderAmount BigInt?                               @map("minimum_order_amount")
  deliveryTimeMin    Int?                                  @map("delivery_time_min")
  deliveryTimeMax    Int?                                  @map("delivery_time_max")
  ratingAvg          Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount        Int                                   @default(0) @map("review_count")
  isOpen             Boolean                               @default(false) @map("is_open")
  isActive           Boolean                               @default(true) @map("is_active")
  ageRestricted      Boolean                               @default(false) @map("age_restricted")
  tags               String[]                              @default([])
  navigationRoute    String?                               @map("navigation_route") @db.VarChar(255)
  navigationParams   Json?                                 @map("navigation_params")
  version            Int                                   @default(0)
  createdAt          DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  deletedBy          String?                               @map("deleted_by") @db.Uuid
  deleteReason       String?                               @map("delete_reason") @db.VarChar(500)
  createdBy          String?                               @map("created_by") @db.Uuid
  updatedBy          String?                               @map("updated_by") @db.Uuid

  merchant       Merchant           @relation(fields: [merchantId], references: [id], onDelete: Restrict, map: "stores_merchant_fkey")
  openingHours   StoreOpeningHour[]
  categories     Category[]
  products       Product[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  orders         Order[]
  reviews        Review[]

  @@index([merchantId, storeType])
  @@index([storeType, isActive, isOpen])
  @@index([city, storeType])
  @@index([ratingAvg])
  @@index([deletedAt])
  @@map("stores")
}

model StoreOpeningHour {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  day       DayOfWeek
  openTime  String?   @map("open_time") @db.VarChar(5)
  closeTime String?   @map("close_time") @db.VarChar(5)
  isClosed  Boolean   @default(false) @map("is_closed")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "store_opening_hours_store_fkey")

  @@unique([storeId, day])
  @@map("store_opening_hours")
}

// ============================================================================
// CATALOG
// ============================================================================

model Category {
  id         String     @id @default(uuid()) @db.Uuid
  storeId    String?    @map("store_id") @db.Uuid
  moduleType ModuleType @map("module_type")
  name       String     @db.VarChar(120)
  slug       String     @db.VarChar(120)
  iconKey    String?    @map("icon_key") @db.VarChar(64)
  imageUrl   String?    @map("image_url") @db.Text
  sortOrder  Int        @default(0) @map("sort_order")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?  @map("deleted_at") @db.Timestamptz(6)

  store    Store?    @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "categories_store_fkey")
  products Product[]

  @@unique([moduleType, slug, storeId])
  @@index([moduleType, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id              String              @id @default(uuid()) @db.Uuid
  storeId         String              @map("store_id") @db.Uuid
  categoryId      String?             @map("category_id") @db.Uuid
  cylinderTypeId  String?             @map("cylinder_type_id") @db.Uuid
  name            String              @db.VarChar(200)
  description     String?             @db.Text
  brand           String?             @db.VarChar(120)
  sku             String?             @db.VarChar(64)
  priceAmount     BigInt              @map("price_amount")
  originalPrice   BigInt?             @map("original_price")
  currency        String              @default("KES") @db.Char(3)
  discountPercent Int?                @map("discount_percent")
  imageUrl        String?             @map("image_url") @db.Text
  inStock         Boolean             @default(true) @map("in_stock")
  isActive        Boolean             @default(true) @map("is_active")
  ageRestricted   Boolean             @default(false) @map("age_restricted")
  /// Display label e.g. "6kg" — prefer cylinderType for pricing engine
  sizeLabel       String?             @map("size_label") @db.VarChar(32)
  volumeLabel     String?             @map("volume_label") @db.VarChar(32)
  abv             Decimal?            @db.Decimal(5, 2)
  country         String?             @db.VarChar(80)
  unitLabel       String?             @map("unit_label") @db.VarChar(32)
  weightKg        Decimal?            @map("weight_kg") @db.Decimal(8, 3)
  lengthCm        Decimal?            @map("length_cm") @db.Decimal(8, 2)
  widthCm         Decimal?            @map("width_cm") @db.Decimal(8, 2)
  heightCm        Decimal?            @map("height_cm") @db.Decimal(8, 2)
  serviceType     ProductServiceType? @map("service_type")
  tags            String[]            @default([])
  sortOrder       Int                 @default(0) @map("sort_order")
  version         Int                 @default(0)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?           @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?             @map("deleted_by") @db.Uuid
  deleteReason    String?             @map("delete_reason") @db.VarChar(500)

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "products_store_fkey")
  category     Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "products_category_fkey")
  cylinderType CylinderType?         @relation(fields: [cylinderTypeId], references: [id], onDelete: SetNull, map: "products_cylinder_type_fkey")
  orderItems   OrderItem[]
  cartItems    CartItem[]
  reviews      Review[]
  ticketTypes  EventTicketType[]
  pricingRules DeliveryPricingRule[]

  @@index([storeId, isActive, inStock])
  @@index([categoryId])
  @@index([cylinderTypeId])
  @@index([brand])
  @@index([priceAmount])
  @@index([deletedAt])
  @@map("products")
}

model MenuCategory {
  id          String    @id @default(uuid()) @db.Uuid
  storeId     String    @map("store_id") @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  store Store      @relation(fields: [storeId], references: [id], onDelete: Cascade, map: "menu_categories_store_fkey")
  items MenuItem[]

  @@index([storeId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id              String    @id @default(uuid()) @db.Uuid
  storeId         String    @map("store_id") @db.Uuid
  menuCategoryId  String    @map("menu_category_id") @db.Uuid
  name            String    @db.VarChar(200)
  description     String?   @db.Text
  priceAmount     BigInt    @map("price_amount")
  currency        String    @default("KES") @db.Char(3)
  imageUrl        String?   @map("image_url") @db.Text
  isAvailable     Boolean   @default(true) @map("is_available")
  preparationTime Int?      @map("preparation_time")
  calories        Int?
  tags            String[]  @default([])
  sortOrder       Int       @default(0) @map("sort_order")
  version         Int       @default(0)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?   @map("deleted_by") @db.Uuid

  menuCategory   MenuCategory    @relation(fields: [menuCategoryId], references: [id], onDelete: Cascade, map: "menu_items_category_fkey")
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "menu_items_store_fkey")
  modifierGroups ModifierGroup[]
  favourites     MenuFavourite[]
  orderItems     OrderItem[]
  cartItems      CartItem[]
  reviews        Review[]

  @@index([storeId, isAvailable])
  @@index([menuCategoryId, sortOrder])
  @@index([deletedAt])
  @@map("menu_items")
}

model ModifierGroup {
  id         String   @id @default(uuid()) @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  name       String   @db.VarChar(120)
  minSelect  Int      @default(0) @map("min_select")
  maxSelect  Int      @default(1) @map("max_select")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  menuItem MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "modifier_groups_item_fkey")
  options  ModifierOption[]

  @@index([menuItemId, sortOrder])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String   @id @default(uuid()) @db.Uuid
  modifierGroupId String   @map("modifier_group_id") @db.Uuid
  name            String   @db.VarChar(120)
  priceDelta      BigInt   @default(0) @map("price_delta")
  currency        String   @default("KES") @db.Char(3)
  isDefault       Boolean  @default(false) @map("is_default")
  isAvailable     Boolean  @default(true) @map("is_available")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade, map: "modifier_options_group_fkey")

  @@index([modifierGroupId, sortOrder])
  @@map("modifier_options")
}

model MenuFavourite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  menuItemId String   @map("menu_item_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "menu_favourites_user_fkey")
  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade, map: "menu_favourites_item_fkey")

  @@unique([userId, menuItemId])
  @@index([menuItemId])
  @@map("menu_favourites")
}

model SavedItem {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  kind      SavedItemKind
  targetId  String        @map("target_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "saved_items_user_fkey")

  @@unique([userId, kind, targetId])
  @@index([kind, targetId])
  @@map("saved_items")
}

// ============================================================================
// CART (server-side; UI currently AsyncStorage — schema ready)
// ============================================================================

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  moduleType ModuleType @map("module_type")
  storeId    String?    @map("store_id") @db.Uuid
  currency   String     @default("KES") @db.Char(3)
  version    Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade, map: "carts_user_fkey")
  items CartItem[]

  @@unique([userId, moduleType, storeId])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid()) @db.Uuid
  cartId            String   @map("cart_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  menuItemId        String?  @map("menu_item_id") @db.Uuid
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(200)
  unitPriceAmount   BigInt   @map("unit_price_amount")
  currency          String   @default("KES") @db.Char(3)
  quantity          Int
  notes             String?  @db.Text
  modifierOptionIds String[] @default([]) @map("modifier_option_ids") @db.Uuid
  imageUrl          String?  @map("image_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart     Cart      @relation(fields: [cartId], references: [id], onDelete: Cascade, map: "cart_items_cart_fkey")
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull, map: "cart_items_product_fkey")
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull, map: "cart_items_menu_item_fkey")

  @@index([cartId])
  @@map("cart_items")
}

// ============================================================================
// ORDERS (unified across food / market / liquor / gas / merchant)
// ============================================================================

model Order {
  id                       String            @id @default(uuid()) @db.Uuid
  moduleType               ModuleType        @map("module_type")
  status                   ModuleOrderStatus @default(PENDING_PAYMENT)
  customerId               String            @map("customer_id") @db.Uuid
  storeId                  String            @map("store_id") @db.Uuid
  riderId                  String?           @map("rider_id") @db.Uuid
  deliveryAddress          String?           @map("delivery_address") @db.Text
  deliveryLatitude         Decimal?          @map("delivery_latitude") @db.Decimal(10, 7)
  deliveryLongitude        Decimal?          @map("delivery_longitude") @db.Decimal(10, 7)
  notes                    String?           @db.Text
  subtotalAmount           BigInt            @map("subtotal_amount")
  deliveryFeeAmount        BigInt            @default(0) @map("delivery_fee_amount")
  serviceFeeAmount         BigInt            @default(0) @map("service_fee_amount")
  totalAmount              BigInt            @map("total_amount")
  currency                 String            @default("KES") @db.Char(3)
  baseCurrency             String            @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate             Decimal           @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  paymentMethod            PaymentMethod     @default(MOBILE_MONEY) @map("payment_method")
  paymentStatus            PaymentStatus     @default(PENDING) @map("payment_status")
  distanceKm               Decimal?          @map("distance_km") @db.Decimal(8, 3)
  packageWeightKg          Decimal?          @map("package_weight_kg") @db.Decimal(8, 3)
  packageLengthCm          Decimal?          @map("package_length_cm") @db.Decimal(8, 2)
  packageWidthCm           Decimal?          @map("package_width_cm") @db.Decimal(8, 2)
  packageHeightCm          Decimal?          @map("package_height_cm") @db.Decimal(8, 2)
  /// Snapshot of rule used at quote time — never mutate historical pricing
  deliveryPricingRuleId    String?           @map("delivery_pricing_rule_id") @db.Uuid
  deliveryConstraintId     String?           @map("delivery_constraint_id") @db.Uuid
  /// Persisted checkout quote that priced this order (single source of truth).
  pricingQuoteId           String?           @map("pricing_quote_id") @db.Uuid
  riderPayAmount           BigInt            @default(0) @map("rider_pay_amount")
  platformCommissionAmount BigInt            @default(0) @map("platform_commission_amount")
  merchantCommissionAmount BigInt            @default(0) @map("merchant_commission_amount")
  /// Customer history hide (UI DELETE history) — NOT financial soft-delete
  customerHiddenAt         DateTime?         @map("customer_hidden_at") @db.Timestamptz(6)
  acceptedAt               DateTime?         @map("accepted_at") @db.Timestamptz(6)
  preparedAt               DateTime?         @map("prepared_at") @db.Timestamptz(6)
  readyAt                  DateTime?         @map("ready_at") @db.Timestamptz(6)
  pickedUpAt               DateTime?         @map("picked_up_at") @db.Timestamptz(6)
  deliveredAt              DateTime?         @map("delivered_at") @db.Timestamptz(6)
  cancelledAt              DateTime?         @map("cancelled_at") @db.Timestamptz(6)
  cancelReason             String?           @map("cancel_reason") @db.VarChar(500)
  version                  Int               @default(0)
  createdAt                DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                DateTime?         @map("deleted_at") @db.Timestamptz(6)
  deletedBy                String?           @map("deleted_by") @db.Uuid
  deleteReason             String?           @map("delete_reason") @db.VarChar(500)
  createdBy                String?           @map("created_by") @db.Uuid
  updatedBy                String?           @map("updated_by") @db.Uuid

  customer            User                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Restrict, map: "orders_customer_fkey")
  store               Store                @relation(fields: [storeId], references: [id], onDelete: Restrict, map: "orders_store_fkey")
  rider               Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull, map: "orders_rider_fkey")
  deliveryPricingRule DeliveryPricingRule? @relation(fields: [deliveryPricingRuleId], references: [id], onDelete: SetNull, map: "orders_pricing_rule_fkey")
  deliveryConstraint  DeliveryConstraint?  @relation(fields: [deliveryConstraintId], references: [id], onDelete: SetNull, map: "orders_constraint_fkey")
  pricingQuote        PricingQuote?        @relation(fields: [pricingQuoteId], references: [id], onDelete: SetNull, map: "orders_pricing_quote_fkey")
  items               OrderItem[]
  statusHistory       OrderStatusHistory[]
  payments            Payment[]
  escrowHolds         EscrowHold[]
  reviews             Review[]
  cylinderExchanges   CylinderExchange[]
  eventBookings       EventBooking[]
  financialDocuments  FinancialDocument[]
  proofOfDelivery     ProofOfDelivery?

  @@index([customerId, moduleType, createdAt])
  @@index([storeId, status, createdAt])
  @@index([status, paymentStatus, createdAt])
  @@index([riderId, status])
  @@index([customerHiddenAt])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String?  @map("product_id") @db.Uuid
  menuItemId        String?  @map("menu_item_id") @db.Uuid
  nameSnapshot      String   @map("name_snapshot") @db.VarChar(200)
  unitPriceAmount   BigInt   @map("unit_price_amount")
  quantity          Int
  lineTotalAmount   BigInt   @map("line_total_amount")
  currency          String   @default("KES") @db.Char(3)
  notes             String?  @db.Text
  modifierOptionIds String[] @default([]) @map("modifier_option_ids") @db.Uuid
  modifiersSnapshot Json?    @map("modifiers_snapshot")
  imageUrl          String?  @map("image_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "order_items_order_fkey")
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull, map: "order_items_product_fkey")
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull, map: "order_items_menu_item_fkey")

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  fromStatus ModuleOrderStatus? @map("from_status")
  toStatus   ModuleOrderStatus  @map("to_status")
  actorType  ActorType          @default(SYSTEM) @map("actor_type")
  actorId    String?            @map("actor_id") @db.Uuid
  reason     String?            @db.VarChar(500)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade, map: "order_status_history_order_fkey")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

