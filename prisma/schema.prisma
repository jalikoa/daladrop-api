model EventOrganizer {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  orgName   String?   @map("org_name") @db.VarChar(200)
  phone     String?   @db.VarChar(32)
  whatsapp  String?   @db.VarChar(32)
  email     String?   @db.VarChar(255)
  website   String?   @db.Text
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Restrict, map: "event_organizers_user_fkey")
  events Event[]
  wallet Wallet? @relation("OrganizerWallet")

  @@map("event_organizers")
}

model EventCategory {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(120)
  iconKey   String?   @map("icon_key") @db.VarChar(64)
  imageUrl  String?   @map("image_url") @db.Text
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  events Event[]

  @@index([isActive, sortOrder])
  @@map("event_categories")
}

model Event {
  id              String                                @id @default(uuid()) @db.Uuid
  /// Organizer merchant — events settle through merchant wallet / contracts
  merchantId      String                                @map("merchant_id") @db.Uuid
  organizerId     String?                               @map("organizer_id") @db.Uuid
  categoryId      String?                               @map("category_id") @db.Uuid
  name            String                                @db.VarChar(255)
  description     String?                               @db.Text
  venue           String?                               @db.VarChar(255)
  address         String?                               @db.Text
  city            String?                               @db.VarChar(100)
  bannerUrl       String?                               @map("banner_url") @db.Text
  coverImageUrl   String?                               @map("cover_image_url") @db.Text
  gallery         String[]                              @default([])
  startAt         DateTime                              @map("start_at") @db.Timestamptz(6)
  endAt           DateTime?                             @map("end_at") @db.Timestamptz(6)
  status          EventStatus                           @default(DRAFT)
  latitude        Decimal?                              @db.Decimal(10, 7)
  longitude       Decimal?                              @db.Decimal(10, 7)
  location        Unsupported("geography(Point,4326)")?
  ratingAvg       Decimal                               @default(0) @map("rating_avg") @db.Decimal(3, 2)
  reviewCount     Int                                   @default(0) @map("review_count")
  isFeatured      Boolean                               @default(false) @map("is_featured")
  navigationRoute String?                               @map("navigation_route") @db.VarChar(255)
  version         Int                                   @default(0)
  createdAt       DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?                             @map("deleted_at") @db.Timestamptz(6)
  deletedBy       String?                               @map("deleted_by") @db.Uuid
  deleteReason    String?                               @map("delete_reason") @db.VarChar(500)

  merchant    Merchant          @relation(fields: [merchantId], references: [id], onDelete: Restrict, map: "events_merchant_fkey")
  organizer   EventOrganizer?   @relation(fields: [organizerId], references: [id], onDelete: SetNull, map: "events_organizer_fkey")
  category    EventCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull, map: "events_category_fkey")
  ticketTypes EventTicketType[]
  bookings    EventBooking[]
  reviews     Review[]

  @@index([merchantId, status])
  @@index([status, startAt])
  @@index([city, startAt])
  @@index([categoryId, status])
  @@index([isFeatured, startAt])
  @@index([deletedAt])
  @@map("events")
}

model EventTicketType {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  /// Optional link into catalog Product for unified settlement / inventory
  productId   String?   @map("product_id") @db.Uuid
  name        String    @db.VarChar(120)
  priceAmount BigInt    @map("price_amount")
  currency    String    @default("KES") @db.Char(3)
  totalQty    Int       @map("total_qty")
  soldQty     Int       @default(0) @map("sold_qty")
  isActive    Boolean   @default(true) @map("is_active")
  version     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  event    Event          @relation(fields: [eventId], references: [id], onDelete: Restrict, map: "event_ticket_types_event_fkey")
  product  Product?       @relation(fields: [productId], references: [id], onDelete: SetNull, map: "event_ticket_types_product_fkey")
  bookings EventBooking[]
  tickets  EventTicket[]

  @@index([eventId, isActive])
  @@index([productId])
  @@map("event_ticket_types")
}

model EventBooking {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  ticketTypeId  String        @map("ticket_type_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  /// Checkout order — payments & settlement flow through Order
  orderId       String?       @map("order_id") @db.Uuid
  status        BookingStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  quantity      Int
  amount        BigInt
  currency      String        @default("KES") @db.Char(3)
  baseCurrency  String        @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate  Decimal       @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  phone         String?       @db.VarChar(20)
  message       String?       @db.Text
  version       Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(6)

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Restrict, map: "event_bookings_event_fkey")
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, map: "event_bookings_ticket_type_fkey")
  customer   User            @relation(fields: [customerId], references: [id], onDelete: Restrict, map: "event_bookings_customer_fkey")
  order      Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull, map: "event_bookings_order_fkey")
  tickets    EventTicket[]
  payments   Payment[]

  @@index([customerId, createdAt])
  @@index([eventId, status])
  @@index([orderId])
  @@index([status, paymentStatus])
  @@map("event_bookings")
}

model EventTicket {
  id           String       @id @default(uuid()) @db.Uuid
  bookingId    String       @map("booking_id") @db.Uuid
  ticketTypeId String       @map("ticket_type_id") @db.Uuid
  qrCode       String       @unique @map("qr_code") @db.VarChar(255)
  status       TicketStatus @default(VALID)
  usedAt       DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    EventBooking    @relation(fields: [bookingId], references: [id], onDelete: Restrict, map: "event_tickets_booking_fkey")
  ticketType EventTicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict, map: "event_tickets_type_fkey")

  @@index([bookingId])
  @@index([status])
  @@map("event_tickets")
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id         String           @id @default(uuid()) @db.Uuid
  authorId   String           @map("author_id") @db.Uuid
  targetType ReviewTargetType @map("target_type")
  storeId    String?          @map("store_id") @db.Uuid
  productId  String?          @map("product_id") @db.Uuid
  menuItemId String?          @map("menu_item_id") @db.Uuid
  riderId    String?          @map("rider_id") @db.Uuid
  eventId    String?          @map("event_id") @db.Uuid
  orderId    String?          @map("order_id") @db.Uuid
  rideId     String?          @map("ride_id") @db.Uuid
  score      Int
  comment    String?          @db.Text
  tags       String[]         @default([])
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz(6)

  author   User      @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict, map: "reviews_author_fkey")
  store    Store?    @relation(fields: [storeId], references: [id], onDelete: SetNull, map: "reviews_store_fkey")
  product  Product?  @relation(fields: [productId], references: [id], onDelete: SetNull, map: "reviews_product_fkey")
  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull, map: "reviews_menu_item_fkey")
  rider    Rider?    @relation("RiderReviews", fields: [riderId], references: [id], onDelete: SetNull, map: "reviews_rider_fkey")
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull, map: "reviews_event_fkey")
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull, map: "reviews_order_fkey")
  ride     Ride?     @relation(fields: [rideId], references: [id], onDelete: SetNull, map: "reviews_ride_fkey")

  @@index([targetType, storeId])
  @@index([authorId, createdAt])
  @@index([orderId])
  @@index([rideId])
  @@map("reviews")
}

// ============================================================================
// LOGISTICS PRICING & CONSTRAINTS (config-driven — never hardcode bands in app)
// ============================================================================

/// Gas cylinder catalog used by pricing engine (6kg / 13kg today).
model CylinderType {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(120)
  weightKg    Decimal  @map("weight_kg") @db.Decimal(8, 3)
  description String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products     Product[]
  pricingRules DeliveryPricingRule[]
  exchangesOld CylinderExchange[]    @relation("OldCylinderType")
  exchangesNew CylinderExchange[]    @relation("NewCylinderType")

  @@map("cylinder_types")
}

model DeliveryConstraint {
  id                  String                @id @default(uuid()) @db.Uuid
  name                String                @db.VarChar(120)
  serviceType         LogisticsServiceType  @map("service_type")
  vehicleType         VehicleType           @default(BIKE) @map("vehicle_type")
  maxDistanceKm       Decimal               @map("max_distance_km") @db.Decimal(8, 3)
  maxWeightKg         Decimal               @map("max_weight_kg") @db.Decimal(8, 3)
  maxLengthCm         Decimal               @map("max_length_cm") @db.Decimal(8, 2)
  maxWidthCm          Decimal               @map("max_width_cm") @db.Decimal(8, 2)
  maxHeightCm         Decimal               @map("max_height_cm") @db.Decimal(8, 2)
  /// When exceeded, engine should switch to this service (e.g. PARCEL)
  overflowServiceType LogisticsServiceType? @map("overflow_service_type")
  effectiveFrom       DateTime              @map("effective_from") @db.Timestamptz(6)
  effectiveTo         DateTime?             @map("effective_to") @db.Timestamptz(6)
  enabled             Boolean               @default(true)
  version             Int                   @default(0)
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders Order[]

  @@index([serviceType, vehicleType, enabled])
  @@index([effectiveFrom, effectiveTo])
  @@map("delivery_constraints")
}

/// Versioned delivery fee / rider pay / platform margin bands.
model DeliveryPricingRule {
  id                 String               @id @default(uuid()) @db.Uuid
  name               String?              @db.VarChar(120)
  serviceType        LogisticsServiceType @map("service_type")
  vehicleType        VehicleType          @default(BIKE) @map("vehicle_type")
  distanceMinKm      Decimal              @map("distance_min_km") @db.Decimal(8, 3)
  distanceMaxKm      Decimal              @map("distance_max_km") @db.Decimal(8, 3)
  weightMinKg        Decimal?             @map("weight_min_kg") @db.Decimal(8, 3)
  weightMaxKg        Decimal?             @map("weight_max_kg") @db.Decimal(8, 3)
  productId          String?              @map("product_id") @db.Uuid
  cylinderTypeId     String?              @map("cylinder_type_id") @db.Uuid
  customerCharge     BigInt               @map("customer_charge")
  riderPay           BigInt               @map("rider_pay")
  platformCommission BigInt               @map("platform_commission")
  currency           String               @default("KES") @db.Char(3)
  baseCurrency       String               @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate       Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  effectiveFrom      DateTime             @map("effective_from") @db.Timestamptz(6)
  effectiveTo        DateTime?            @map("effective_to") @db.Timestamptz(6)
  priority           Int                  @default(100)
  enabled            Boolean              @default(true)
  version            Int                  @default(0)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull, map: "delivery_pricing_rules_product_fkey")
  cylinderType CylinderType? @relation(fields: [cylinderTypeId], references: [id], onDelete: SetNull, map: "delivery_pricing_rules_cylinder_fkey")
  orders       Order[]
  rides        Ride[]

  @@index([serviceType, vehicleType, enabled, priority])
  @@index([cylinderTypeId, enabled])
  @@index([effectiveFrom, effectiveTo])
  @@map("delivery_pricing_rules")
}

model ParcelPricingProfile {
  id               String               @id @default(uuid()) @db.Uuid
  name             String               @db.VarChar(120)
  serviceType      LogisticsServiceType @map("service_type")
  /// Rule payloads remain structured JSON so parcel math can evolve without migrations
  distanceRule     Json                 @map("distance_rule")
  weightRule       Json                 @map("weight_rule")
  volumeRule       Json?                @map("volume_rule")
  insuranceRule    Json?                @map("insurance_rule")
  expressCharge    BigInt               @default(0) @map("express_charge")
  fragileSurcharge BigInt               @default(0) @map("fragile_surcharge")
  currency         String               @default("KES") @db.Char(3)
  baseCurrency     String               @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate     Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  effectiveFrom    DateTime             @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime?            @map("effective_to") @db.Timestamptz(6)
  enabled          Boolean              @default(true)
  version          Int                  @default(0)
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  rides Ride[]

  @@index([serviceType, enabled])
  @@index([effectiveFrom, effectiveTo])
  @@map("parcel_pricing_profiles")
}

/// Merchant commercial terms (liquor commissions, listing fees, etc.).
model MerchantContract {
  id             String               @id @default(uuid()) @db.Uuid
  merchantId     String               @map("merchant_id") @db.Uuid
  serviceType    LogisticsServiceType @map("service_type")
  moduleType     ModuleType?          @map("module_type")
  name           String               @db.VarChar(120)
  commissionType CommissionType       @map("commission_type")
  fixedAmount    BigInt               @default(0) @map("fixed_amount")
  percentageBps  Int                  @default(0) @map("percentage_bps")
  minimumCharge  BigInt               @default(0) @map("minimum_charge")
  maximumCharge  BigInt?              @map("maximum_charge")
  currency       String               @default("KES") @db.Char(3)
  baseCurrency   String               @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate   Decimal              @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  effectiveFrom  DateTime             @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?            @map("effective_to") @db.Timestamptz(6)
  enabled        Boolean              @default(true)
  version        Int                  @default(0)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Restrict, map: "merchant_contracts_merchant_fkey")

  @@index([merchantId, enabled])
  @@index([serviceType, moduleType])
  @@index([effectiveFrom, effectiveTo])
  @@map("merchant_contracts")
}

model CylinderExchange {
  id                   String   @id @default(uuid()) @db.Uuid
  orderId              String   @map("order_id") @db.Uuid
  oldCylinderTypeId    String?  @map("old_cylinder_type_id") @db.Uuid
  newCylinderTypeId    String?  @map("new_cylinder_type_id") @db.Uuid
  oldCylinderReceived  Boolean  @default(false) @map("old_cylinder_received")
  newCylinderDelivered Boolean  @default(false) @map("new_cylinder_delivered")
  verifiedBy           String?  @map("verified_by") @db.Uuid
  notes                String?  @db.Text
  exchangedAt          DateTime @default(now()) @map("exchanged_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "cylinder_exchanges_order_fkey")
  oldCylinderType CylinderType? @relation("OldCylinderType", fields: [oldCylinderTypeId], references: [id], onDelete: SetNull, map: "cylinder_exchanges_old_fkey")
  newCylinderType CylinderType? @relation("NewCylinderType", fields: [newCylinderTypeId], references: [id], onDelete: SetNull, map: "cylinder_exchanges_new_fkey")

  @@index([orderId])
  @@map("cylinder_exchanges")
}

model SettlementPolicy {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @db.VarChar(120)
  beneficiaryType  WalletOwnerType     @map("beneficiary_type")
  frequency        SettlementFrequency
  /// ISO weekday 1=Monday .. 7=Sunday (Friday = 5). Null for non-weekly.
  cutoffDay        Int?                @map("cutoff_day") @db.SmallInt
  cutoffTime       String              @map("cutoff_time") @db.VarChar(8)
  timezone         String              @default("Africa/Nairobi") @db.VarChar(64)
  minimumAmount    BigInt              @default(0) @map("minimum_amount")
  currency         String              @default("KES") @db.Char(3)
  requiresApproval Boolean             @default(false) @map("requires_approval")
  autoSettlement   Boolean             @default(true) @map("auto_settlement")
  enabled          Boolean             @default(true)
  version          Int                 @default(0)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  batches SettlementBatch[]
  payouts Settlement[]

  @@index([beneficiaryType, enabled])
  @@map("settlement_policies")
}

// ============================================================================
// PAYMENTS & ACCOUNTING (provider-agnostic core + integration side-tables)
// ============================================================================

model ChartOfAccounts {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(32)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  currency    String   @default("KES") @db.Char(3)
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  accounts Account[]

  @@map("charts_of_accounts")
}

model Account {
  id                String        @id @default(uuid()) @db.Uuid
  chartOfAccountsId String        @map("chart_of_accounts_id") @db.Uuid
  code              String        @db.VarChar(32)
  name              String        @db.VarChar(200)
  accountType       AccountType   @map("account_type")
  normalBalance     NormalBalance @map("normal_balance")
  parentId          String?       @map("parent_id") @db.Uuid
  currency          String        @default("KES") @db.Char(3)
  isSystem          Boolean       @default(false) @map("is_system")
  isActive          Boolean       @default(true) @map("is_active")
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  chart    ChartOfAccounts  @relation(fields: [chartOfAccountsId], references: [id], onDelete: Restrict, map: "accounts_chart_fkey")
  parent   Account?         @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict, map: "accounts_parent_fkey")
  children Account[]        @relation("AccountHierarchy")
  lines    JournalLine[]
  balances AccountBalance[]

  @@unique([chartOfAccountsId, code])
  @@index([accountType, isActive])
  @@map("accounts")
}

model FiscalPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  name      String             @db.VarChar(64)
  startsAt  DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt    DateTime           @map("ends_at") @db.Timestamptz(6)
  status    FiscalPeriodStatus @default(OPEN)
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  accountingPeriods AccountingPeriod[]

  @@index([startsAt, endsAt])
  @@map("fiscal_periods")
}

model AccountingPeriod {
  id             String             @id @default(uuid()) @db.Uuid
  fiscalPeriodId String             @map("fiscal_period_id") @db.Uuid
  name           String             @db.VarChar(64)
  startsAt       DateTime           @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime           @map("ends_at") @db.Timestamptz(6)
  status         FiscalPeriodStatus @default(OPEN)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  fiscalPeriod FiscalPeriod     @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict, map: "accounting_periods_fiscal_fkey")
  balances     AccountBalance[]
  journals     JournalEntry[]

  @@index([fiscalPeriodId, startsAt])
  @@map("accounting_periods")
}

model AccountBalance {
  id                 String   @id @default(uuid()) @db.Uuid
  accountId          String   @map("account_id") @db.Uuid
  accountingPeriodId String   @map("accounting_period_id") @db.Uuid
  debitTotal         BigInt   @default(0) @map("debit_total")
  creditTotal        BigInt   @default(0) @map("credit_total")
  closingBalance     BigInt   @default(0) @map("closing_balance")
  currency           String   @default("KES") @db.Char(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          Account          @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "account_balances_account_fkey")
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict, map: "account_balances_period_fkey")

  @@unique([accountId, accountingPeriodId])
  @@map("account_balances")
}

/// Immutable once POSTED. Void via reversing entry — never mutate amounts.
model JournalEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  entryNumber        String             @unique @map("entry_number") @db.VarChar(64)
  status             JournalEntryStatus @default(DRAFT)
  description        String?            @db.Text
  valueDate          DateTime           @map("value_date") @db.Timestamptz(6)
  currency           String             @default("KES") @db.Char(3)
  baseCurrency       String             @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate       Decimal            @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  accountingPeriodId String?            @map("accounting_period_id") @db.Uuid
  externalRef        String?            @map("external_ref") @db.VarChar(128)
  internalRef        String?            @map("internal_ref") @db.VarChar(128)
  paymentId          String?            @unique @map("payment_id") @db.Uuid
  postedAt           DateTime?          @map("posted_at") @db.Timestamptz(6)
  postedBy           String?            @map("posted_by") @db.Uuid
  voidedAt           DateTime?          @map("voided_at") @db.Timestamptz(6)
  voidReason         String?            @map("void_reason") @db.VarChar(500)
  reversesEntryId    String?            @map("reverses_entry_id") @db.Uuid
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  payment          Payment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "journal_entries_payment_fkey")
  accountingPeriod AccountingPeriod? @relation(fields: [accountingPeriodId], references: [id], onDelete: SetNull, map: "journal_entries_period_fkey")
  reversesEntry    JournalEntry?     @relation("JournalReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict, map: "journal_entries_reverses_fkey")
  reversedBy       JournalEntry[]    @relation("JournalReversal")
  lines            JournalLine[]

  @@index([status, valueDate])
  @@index([externalRef])
  @@index([internalRef])
  @@map("journal_entries")
}

model JournalLine {
  id               String   @id @default(uuid()) @db.Uuid
  journalEntryId   String   @map("journal_entry_id") @db.Uuid
  accountId        String   @map("account_id") @db.Uuid
  lineNo           Int      @map("line_no")
  debitAmount      BigInt   @default(0) @map("debit_amount")
  creditAmount     BigInt   @default(0) @map("credit_amount")
  currency         String   @default("KES") @db.Char(3)
  baseCurrency     String   @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate     Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  baseDebitAmount  BigInt   @default(0) @map("base_debit_amount")
  baseCreditAmount BigInt   @default(0) @map("base_credit_amount")
  memo             String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict, map: "journal_lines_entry_fkey")
  account      Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, map: "journal_lines_account_fkey")

  @@unique([journalEntryId, lineNo])
  @@index([accountId, createdAt])
  @@map("journal_lines")
}

/// Liability wallet — not a payment provider.
model Wallet {
  id            String          @id @default(uuid()) @db.Uuid
  ownerType     WalletOwnerType @map("owner_type")
  ownerId       String          @map("owner_id") @db.Uuid
  userId        String?         @map("user_id") @db.Uuid
  merchantId    String?         @unique @map("merchant_id") @db.Uuid
  riderId       String?         @unique @map("rider_id") @db.Uuid
  organizerId   String?         @unique @map("organizer_id") @db.Uuid
  currency      String          @default("KES") @db.Char(3)
  balanceAmount BigInt          @default(0) @map("balance_amount")
  holdAmount    BigInt          @default(0) @map("hold_amount")
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User?               @relation(fields: [userId], references: [id], onDelete: Restrict, map: "wallets_user_fkey")
  merchant     Merchant?           @relation("MerchantWallet", fields: [merchantId], references: [id], onDelete: Restrict, map: "wallets_merchant_fkey")
  rider        Rider?              @relation("RiderWallet", fields: [riderId], references: [id], onDelete: Restrict, map: "wallets_rider_fkey")
  organizer    EventOrganizer?     @relation("OrganizerWallet", fields: [organizerId], references: [id], onDelete: Restrict, map: "wallets_organizer_fkey")
  transactions WalletTransaction[]
  settlements  Settlement[]

  @@unique([ownerType, ownerId, currency])
  @@index([ownerType, ownerId])
  @@map("wallets")
}

/// Append-only wallet liability movements (mirror of journal postings).
model WalletTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  walletId       String                @map("wallet_id") @db.Uuid
  type           WalletTransactionType
  debitAmount    BigInt                @default(0) @map("debit_amount")
  creditAmount   BigInt                @default(0) @map("credit_amount")
  currency       String                @default("KES") @db.Char(3)
  baseCurrency   String                @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate   Decimal               @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  balanceAfter   BigInt                @map("balance_after")
  reference      String?               @db.VarChar(128)
  journalEntryId String?               @map("journal_entry_id") @db.Uuid
  paymentId      String?               @map("payment_id") @db.Uuid
  description    String?               @db.VarChar(500)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet  Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict, map: "wallet_transactions_wallet_fkey")
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull, map: "wallet_transactions_payment_fkey")

  @@index([walletId, createdAt])
  @@index([journalEntryId])
  @@index([paymentId])
  @@index([reference])
  @@unique([walletId, reference], map: "wallet_transactions_wallet_reference_key")
  @@map("wallet_transactions")
}

/// Core payment — no gateway-specific columns.
model Payment {
  id              String                 @id @default(uuid()) @db.Uuid
  purpose         PaymentPurpose
  status          PaymentStatus          @default(PENDING)
  lifecycleStatus PaymentLifecycleStatus @default(DRAFT) @map("lifecycle_status")
  method          PaymentMethod          @default(MOBILE_MONEY)
  provider        PaymentProvider        @default(MPESA_DARAJA)
  amount          BigInt
  currency        String                 @default("KES") @db.Char(3)
  baseCurrency    String                 @default("KES") @map("base_currency") @db.Char(3)
  exchangeRate    Decimal                @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  reference       String?                @unique @db.VarChar(128)
  customerId      String?                @map("customer_id") @db.Uuid
  orderId         String?                @map("order_id") @db.Uuid
  rideId          String?                @map("ride_id") @db.Uuid
  eventBookingId  String?                @map("event_booking_id") @db.Uuid
  idempotencyKey  String?                @unique @map("idempotency_key") @db.VarChar(128)
  internalRef     String?                @map("internal_ref") @db.VarChar(128)
  failureCode     String?                @map("failure_code") @db.VarChar(64)
  failureMessage  String?                @map("failure_message") @db.Text
  expiresAt       DateTime?              @map("expires_at") @db.Timestamptz(6)
  correlationId   String?                @map("correlation_id") @db.VarChar(64)
  traceId         String?                @map("trace_id") @db.VarChar(64)
  metadata        Json?
  initiatedAt     DateTime               @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt     DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  order                Order?                       @relation(fields: [orderId], references: [id], onDelete: Restrict, map: "payments_order_fkey")
  ride                 Ride?                        @relation(fields: [rideId], references: [id], onDelete: Restrict, map: "payments_ride_fkey")
  eventBooking         EventBooking?                @relation(fields: [eventBookingId], references: [id], onDelete: Restrict, map: "payments_booking_fkey")
  providerTransactions PaymentProviderTransaction[]
  references           PaymentReference[]
  allocations          PaymentAllocation[]
  journalEntry         JournalEntry?
  walletTxns           WalletTransaction[]
  escrowHolds          EscrowHold[]
  refunds              Refund[]
  chargebacks          Chargeback[]
  financialDocuments   FinancialDocument[]
  inboundWebhooks      InboundWebhookEvent[]

  @@index([status, createdAt])
  @@index([lifecycleStatus, createdAt])
  @@index([provider, status])
  @@index([orderId])
  @@index([rideId])
  @@index([eventBookingId])
  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@index([correlationId])
  @@index([traceId])
  @@map("payments")
}

/// Multiple provider-independent references attached to a payment.
model PaymentReference {
  id        String               @id @default(uuid()) @db.Uuid
  paymentId String               @map("payment_id") @db.Uuid
  type      PaymentReferenceType
  value     String               @db.VarChar(191)
  /// Empty string when the reference is not provider-scoped (avoids NULL unique gaps).
  provider  String               @default("") @db.VarChar(32)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict, map: "payment_references_payment_fkey")

  @@unique([type, provider, value], map: "payment_references_type_provider_value_key")
  @@index([paymentId])
  @@index([value])
  @@map("payment_references")
}

/// DB-backed payment provider configuration. Secrets live behind secretRef only.
model PaymentProviderConfig {
  id          String                    @id @default(uuid()) @db.Uuid
  code        String                    @unique @db.VarChar(64)
  provider    PaymentProvider
  environment ProviderConfigEnvironment
  enabled     Boolean                   @default(false)
  config      Json                      @default("{}")
  secretRef   String                    @map("secret_ref") @db.VarChar(255)
  version     Int                       @default(1)
  createdAt   DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([provider, environment, version], map: "payment_provider_configs_provider_env_version_key")
  @@index([provider, enabled])
  @@map("payment_provider_configs")
}

/// Inbound provider webhook receipt / replay dedup (outbound uses WebhookDeliveryLog).
model InboundWebhookEvent {
  id             String               @id @default(uuid()) @db.Uuid
  provider       PaymentProvider
  eventId        String               @map("event_id") @db.VarChar(191)
  eventType      String?              @map("event_type") @db.VarChar(128)
  payload        Json
  headers        Json?
  signatureValid Boolean?             @map("signature_valid")
  status         InboundWebhookStatus @default(RECEIVED)
  paymentId      String?              @map("payment_id") @db.Uuid
  errorMessage   String?              @map("error_message") @db.Text
  receivedAt     DateTime             @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt    DateTime?            @map("processed_at") @db.Timestamptz(6)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull, map: "inbound_webhook_events_payment_fkey")

  @@unique([provider, eventId], map: "inbound_webhook_events_provider_event_id_key")
  @@index([status, receivedAt])
  @@index([paymentId])
