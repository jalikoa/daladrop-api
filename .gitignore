# Compiled output
/dist
/build

# Dependencies
/node_modules

# Test & CI artifacts (generated by Jest/jest-junit; uploaded as CI artifacts,
# never committed)
/coverage
/.nyc_output
/reports

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Generated documents
*.pdf

# Environment files (only .env.example / .env.observability are committed)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Local object storage (STORAGE_PROVIDER=local)
/storage
!/storage/.gitkeep

# Node.js diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Temp directories
.temp
.tmp

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.swp
*.swo

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS
.DS_Store
Thumbs.db

dist-infrastructure/
dist-*/
tsconfig.tsbuildinfo
Uidocs/
# Local-only commit helper — never push to GitHub
scripts/commit-rc1-batches.sh
