{
  "title": "API",
  "uid": "api-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["payments", "api"],
  "templating": {
    "list": [
      {
        "name": "interval",
        "type": "interval",
        "options": [{ "text": "1m", "value": "1m" }, { "text": "5m", "value": "5m" }, { "text": "10m", "value": "10m" }],
        "current": { "text": "5m", "value": "5m" }
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Request Rate (req/s)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='api'}[$interval]))", "legendFormat": "req/s" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 50 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Error Rate",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='api',status_code=~'5..'}[$interval])) / sum(rate(http_requests_total{job='api'}[$interval]))", "legendFormat": "error %" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.01 }, { "color": "red", "value": 0.05 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "p95 Latency",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job='api'}[$interval])) by (le))", "legendFormat": "p95" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "red", "value": 2 }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Payments Completed",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(increase(payments_completed_total{job='api'}[$interval]))", "legendFormat": "completed" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } } }
    },
    {
      "id": 5, "type": "stat", "title": "Payment Failure Rate",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(payments_failed_total{job='api'}[$interval])) / (sum(rate(payments_initiated_total{job='api'}[$interval])) + 0.001)", "legendFormat": "fail %" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] } } }
    },
    {
      "id": 6, "type": "stat", "title": "Heap Used",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "nodejs_heap_size_used_bytes{job='api'}", "legendFormat": "heap" }],
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 200000000 }, { "color": "red", "value": 400000000 }] } } }
    },
    {
      "id": 7, "type": "timeseries", "title": "HTTP Request Rate by Route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(http_requests_total{job='api'}[$interval])) by (route, method)", "legendFormat": "{{method}} {{route}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Response Time Percentiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job='api'}[$interval])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.90, sum(rate(http_request_duration_seconds_bucket{job='api'}[$interval])) by (le))", "legendFormat": "p90" },
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job='api'}[$interval])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{job='api'}[$interval])) by (le))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 9, "type": "timeseries", "title": "Payments — Initiated vs Completed vs Failed",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [
        { "expr": "sum(rate(payments_initiated_total{job='api'}[$interval]))", "legendFormat": "initiated" },
        { "expr": "sum(rate(payments_completed_total{job='api'}[$interval]))", "legendFormat": "completed" },
        { "expr": "sum(rate(payments_failed_total{job='api'}[$interval]))", "legendFormat": "failed" }
      ],
      "fieldConfig": { "defaults": { "unit": "cps", "custom": { "lineWidth": 2 } } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Node.js Heap & Event Loop",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [
        { "expr": "nodejs_heap_size_used_bytes{job='api'}", "legendFormat": "heap used" },
        { "expr": "nodejs_heap_size_total_bytes{job='api'}", "legendFormat": "heap total" },
        { "expr": "nodejs_external_memory_bytes{job='api'}", "legendFormat": "external" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "Webhooks Received by Source",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(webhooks_received_total{job='api'}[$interval])) by (source, status)", "legendFormat": "{{source}} ({{status}})" }],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    },
    {
      "id": 12, "type": "timeseries", "title": "Notifications Queued by Channel",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "datasource": { "uid": "prometheus-api" },
      "targets": [{ "expr": "sum(rate(notifications_queued_total{job='api'}[$interval])) by (channel)", "legendFormat": "{{channel}}" }],
      "fieldConfig": { "defaults": { "unit": "cps" } }
    }
  ]
}