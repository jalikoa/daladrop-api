{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", {
      "tsconfig": {
        "module": "commonjs",
        "moduleResolution": "node"
      }
    }]
  },
  "testTimeout": 30000,
  "reporters": [
    "default",
    ["jest-junit", {
      "outputDirectory": "./reports/junit",
      "outputName": "e2e-results.xml"
    }]
  ]
}